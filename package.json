{
  "name": "tegata",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:contrast": "node scripts/check-contrast.mjs",
    "ci": "biome ci . && turbo typecheck test build",
    "db:generate": "pnpm --filter @tegata/db generate",
    "db:migrate": "pnpm --filter @tegata/db migrate",
    "services:up": "docker compose -f infra/compose.yaml --env-file .env up -d --wait",
    "services:down": "docker compose -f infra/compose.yaml --env-file .env down",
    "ops": "pnpm --filter @tegata/core exec tsx src/ops/cli.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@fontsource/noto-serif-jp": "5.3.1",
    "@fontsource/shippori-mincho-b1": "5.3.0",
    "@tegata/typescript-config": "workspace:*",
    "@types/node": "catalog:",
    "opentype.js": "2.0.0",
    "tsx": "catalog:",
    "turbo": "2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.18"
  }
}
