# Copy to .env and fill in. Nothing here is a real secret.

# Local Postgres (pnpm services:up)
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgres://tegata:change-me@127.0.0.1:54330/tegata

# Public URL of the web app
APP_URL=http://localhost:3100

# Operator keys, comma separated (ed25519:...). Create with: node scripts/testnet-account.mjs <name>.testnet
# then: pnpm ops add-keys testnet 3
OPERATOR_KEYS_TESTNET=
# Leave empty to run Sandbox only.
OPERATOR_KEYS_MAINNET=
# The web server never holds operator keys; set this to true there when Live is on.
LIVE_ENABLED=

# Resend (invoice and reminder emails). Leave empty to issue links without email.
# EMAIL_FROM must be on a domain verified in Resend, e.g. Tegata <invoices@tegata.xyz>
RESEND_API_KEY=
EMAIL_FROM=

# Privy (email sign-in): https://dashboard.privy.io
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=
NEXT_PUBLIC_PRIVY_APP_ID=

# Optional: 1Click partner key (https://partners.near-intents.org). Works without it.
ONECLICK_API_KEY=
